# Copy via scripts/init.py; contains no AnkiWeb credentials.
ANKI_PROFILE=POC
ANKI_DECK=POC
ANKI_MODEL=Basic
# scripts/init.py sets these to the host user's IDs.
LOCAL_UID=1000
LOCAL_GID=1000

# Each user needs a unique project, API port, secret directory and journal.
COMPOSE_PROJECT_NAME=anki-poc
ANKI_API_PORT=8765
POC_SECRETS_DIR=./.secrets
POC_STATE_DIR=./.state
